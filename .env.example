# AI-103 live Azure settings
#
# Copy to .env only for local live-lab use. Keep .env out of version control.
# This repo uses Entra ID and DefaultAzureCredential. Do not add API keys,
# tokens, client secrets, or connection strings.

AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Foundry project endpoint format:
# https://<ai-services-account>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_NAME=

# Azure AI Search endpoint format:
# https://<search-service>.search.windows.net
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=

# Content Understanding / Foundry resource endpoint:
# https://<ai-services-account>.services.ai.azure.com
CONTENTUNDERSTANDING_ENDPOINT=
